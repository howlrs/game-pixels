# Cloudflare Pages: HTTP ヘッダ設定 (docs §14.10 / §14.15.5 / §11.2.1 / §17.14 A)
#
# 構文: 1 ブロック = 1 パスパターン (1行目) + 1 ヘッダ/行 (2行目以降、2 スペースインデント)
# 公式: https://developers.cloudflare.com/pages/configuration/headers/

# ---- 全体共通 ----
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: gamepad=(self), fullscreen=(self), accelerometer=(), geolocation=(), microphone=()
  # WebGPU 採用 + 将来 Web Worker / SharedArrayBuffer を使うための事前準備 (§11.2.1)
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
  Cross-Origin-Resource-Policy: same-origin

# ---- index.html: 常に最新を取りに行く (キャッシュしない) ----
/
  Cache-Control: public, max-age=0, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate

# ---- Service Worker: キャッシュ禁止 (Cloudflare のデフォルトを上書き) ----
# §14.10 で sw.js は precache のオーケストレーター。古い sw.js が CDN に固定されると
# 永久に新しいデプロイへ更新されないため、必ず no-store で配信する。
# 2026-05-08: 旧 SW 詰みパターン対策のため no-cache, no-store で確実に CDN/ブラウザ
# どちらでもキャッシュしない指定に変更 (Gemini Pro deep 推奨)。
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
  Service-Worker-Allowed: /
/registerSW.js
  Cache-Control: no-cache, no-store, must-revalidate
/workbox-*.js
  Cache-Control: no-cache, no-store, must-revalidate

# ---- ハッシュ付きアセット: immutable で長期キャッシュ (Vite が hashed filename を生成) ----
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# ---- ステージ JSON: stale-while-revalidate (§14.10 SW でも同戦略) ----
/stages/*
  Cache-Control: public, max-age=300, stale-while-revalidate=86400

# ---- アイコン / manifest ----
/manifest.webmanifest
  Cache-Control: public, max-age=3600
  Content-Type: application/manifest+json
/icon-*.svg
  Cache-Control: public, max-age=86400
/favicon.svg
  Cache-Control: public, max-age=86400
